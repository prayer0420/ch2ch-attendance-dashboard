# Supabase project URL.
# Correct: https://PROJECT_ID.supabase.co
# Wrong:   https://PROJECT_ID.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Settings > API Keys > Publishable key.
# New Supabase projects use sb_publishable_... here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Settings > API Keys > Secret key.
# New Supabase projects use sb_secret_... here.
# Keep this private. Do not paste it into screenshots, GitHub, or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin emails allowed to use the dashboard later.
# Example: user@example.com
ADMIN_EMAILS=

# Local Runner settings.
RUNNER_MODE=true
RUNNER_ID=main-office-pc
RUNNER_POLL_INTERVAL_MS=3000
ENABLE_SUPABASE=true

# The local Runner uses this dashboard URL for queued QR jobs.
RUNNER_DASHBOARD_URL=http://localhost:3000

# CH2CH credentials stay only on this local PC.
CH2CH_USER=
CH2CH_PASSWORD=

# CH2CH login page. Usually no change is needed.
CH2CH_URL=https://ch2ch.or.kr/login.asp

# Keep the browser visible while Playwright is working.
CH2CH_HEADLESS=false

# If true, the legacy automation keeps the browser open forever after finishing.
# For Runner mode, false is recommended so the run can finish and save results.
CH2CH_KEEP_BROWSER_OPEN=false

# Click order: 2청년회 -> 2026전입반 -> 26상 -> 출석부(주별)
TARGET_CLASS_TEXT=2026전입반
TARGET_GROUP_TEXT=26상

# Exact weekly attendance menu text.
WEEKLY_ATTENDANCE_TEXT=출석부(주별)

# Save strategy: smart tries the exact Save button first and uses Alt+S only as fallback.
SAVE_MODE=smart

# Wait until an expected member name appears after clicking a family tab.
# This prevents false "name not found" results while the old family screen is still loading.
FAMILY_TEXT_WAIT_MS=8000

# Legacy fallback only. Normal processing now selects attendance columns from visible
# header/label text such as "주일", "1-3부", "부서", or "4부".
ROW_CHECKBOX_OFFSET=1

# Stop a stuck browser automation after this many milliseconds. Default: 30 minutes.
AUTOMATION_TIMEOUT_MS=1800000
