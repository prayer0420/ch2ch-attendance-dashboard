{
  "name": "ch2ch-attendance-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "CH2CH 출석체크 Windows desktop app",
  "author": "CH2CH",
  "main": "desktop/main.js",
  "scripts": {
    "verify:local-server": "node scripts/verify-local-server.js",
    "build:server": "node scripts/server/build.js",
    "verify:client": "node scripts/verify-client.js",
    "verify:client-package": "node scripts/verify-client.js --packaged",
    "release:web": "node scripts/release/prepare-web-release.js",
    "client:dev": "electron desktop-client",
    "client:dist": "electron-builder --config desktop-client/electron-builder.cjs --win nsis --publish never",
    "verify:app": "node scripts/verify-app-contract.js",
    "verify:app-layout": "node scripts/verify-security-http.js --app",
    "verify:security": "node scripts/verify-security.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "runner": "node runner/src/runner.js",
    "runner:once": "node runner/src/runner.js --once",
    "verify:parser": "node scripts/verify-parser.js",
    "verify:attendance-sync": "node scripts/verify-attendance-sync.js",
    "verify:web-attendance-virtual": "node scripts/verify-web-attendance-virtual.js",
    "verify:member-row": "node scripts/verify-member-row.js",
    "verify:attendance-single-pass": "node scripts/verify-attendance-single-pass.js",
    "verify:web-clear-targets": "node scripts/verify-web-clear-targets.js",
    "verify:save-verification": "node scripts/verify-save-verification.js",
    "verify:run-date-default": "node scripts/verify-run-date-default.js",
    "verify:attendance-sheet-preference": "node scripts/verify-attendance-sheet-preference.js",
    "verify:attendance-sheet-pages": "node scripts/verify-attendance-sheet-pages.js",
    "verify:accounting": "node scripts/accounting/verify-accounting-parser.js",
    "verify:worship-journal-sheet": "node scripts/worship-journal/verify-google-sheet-output.js",
    "verify:worship-journal-publish": "node scripts/worship-journal/verify-google-sheet-publish.js",
    "verify:worship-bulletin": "node scripts/worship-journal/verify-bulletin-parser.js",
    "verify:worship-journal-review": "node scripts/worship-journal/verify-review-digest.js",
    "verify:worship-journal-validation": "node scripts/worship-journal/verify-final-validation.js",
    "verify:worship-journal-attendance": "node scripts/worship-journal/verify-attendance-parser.js",
    "verify:worship-accounting-google": "node scripts/worship-journal/verify-accounting-google-drive.js",
    "verify:band": "node scripts/verify-band-integration.js",
    "configure:worship-journal-google": "node scripts/worship-journal/configure-google-service-account.js",
    "check:worship-journal-google": "node scripts/worship-journal/check-google-connection.js",
    "verify:run-persistence": "node scripts/verify-run-persistence.js",
    "verify:affiliation-correction": "node scripts/verify-affiliation-correction.js",
    "verify:qr-job-queue": "node scripts/verify-qr-job-queue.js",
    "verify:desktop-process": "node scripts/verify-desktop-process-manager.js",
    "verify:desktop-ui": "node scripts/verify-desktop-ui-state.js",
    "verify:desktop-package": "node scripts/verify-desktop-package.js",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "open-dashboard": "start http://localhost:3000",
    "install-browsers": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cfb": "1.2.2",
    "dotenv": "^16.4.7",
    "google-auth-library": "^11.0.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "build": {
    "appId": "kr.ch2ch.attendance",
    "productName": "CH2CH 출석체크",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "project",
        "filter": [
          "app/**",
          "components/**",
          "lib/**",
          "public/**",
          "runner/**",
          "scripts/**",
          "package.json",
          "package-lock.json",
          "next.config.mjs",
          "middleware.ts",
          "next-env.d.ts",
          "tsconfig.json",
          "tailwind.config.*",
          "postcss.config.*",
          "!**/.env*",
          "!**/*.pem",
          "!**/*.key",
          "!**/*service-account*.json",
          "!**/test-*-*.json",
          "!**/node_modules/**",
          "!**/.local-runtime/**",
          "!**/output/**",
          "!**/outputs/**",
          "!**/logs/**",
          "!**/screenshots/**",
          "!**/storage-state*.json",
          "!node_modules/**",
          "!.env.local",
          "!.env.*",
          "!.git/**",
          "!.local-runtime/**",
          "!.next/**",
          "!extras/**",
          "!dist*/**"
        ]
      },
      {
        "from": "node_modules",
        "to": "project/node_modules",
        "filter": [
          "**/*",
          "!.cache/**"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CH2CH 출석체크"
    }
  }
}
