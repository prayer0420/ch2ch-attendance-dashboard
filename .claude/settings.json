{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Bash|PowerShell|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
